# ==========================================
# REPORTLY — ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or real secrets to source control.

# ------------------------------------------
# Supabase Public API Configuration
# ------------------------------------------
# Your Supabase project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase client anonymous API key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------
# Supabase Service Role Configuration (SERVER-ONLY)
# ------------------------------------------
# WARNING: NEVER expose service role keys to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# Application Domain / URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Data Security & Token Encryption (CRITICAL)
# ------------------------------------------
# 32-byte key for AES-256-GCM OAuth token encryption at rest.
# Can be a 64-character hex string, 44-character base64 string, or secure passphrase.
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ------------------------------------------
# Developer Mock Mode for OAuth & External API Testing
# ------------------------------------------
# Set to 'true' to simulate successful OAuth authorization flows without live app approvals
MOCK_OAUTH=true
# Set to 'true' to use mock metric responses for Google Ads, Meta Ads, and GA4 without external API calls
MOCK_EXTERNAL_APIS=true

# ------------------------------------------
# Third-Party OAuth Provider Credentials (PRODUCTION)
# ------------------------------------------
# Google Ads & Google Analytics 4
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Meta Ads (Facebook & Instagram)
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
