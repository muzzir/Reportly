# ==========================================
# REPORTLY — ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or real secrets to source control.

# ------------------------------------------
# Supabase Public API Configuration
# ------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Your Supabase client anonymous API key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------
# Supabase Service Role Configuration (SERVER-ONLY)
# ------------------------------------------
# WARNING: NEVER expose service role keys to the client/browser.
# Only use this on the server for administrative background tasks or migrations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# Application Domain / URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Data Security & Token Encryption
# ------------------------------------------
# Secret key used for encrypting OAuth tokens at rest (min 32 chars)
ENCRYPTION_SECRET=your-32-byte-encryption-secret-here
