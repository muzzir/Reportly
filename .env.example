SUPABASE_SERVICE_ROLE_KEY= "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhpd3NmcXVlY3d0amVnYm5sbWFoIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDEwODY1NywiZXhwIjoyMTA1Njg0NjU3fQ.RMJjlsSWNFWvt-up7dIxQsp1zwRfrEQ1zsU_zNgwq8I"
# ------------------------------------------
# Super Admin Security (SERVER-ONLY)
# ------------------------------------------
# Comma-separated list of emails authorized to access the /admin super admin portal
SUPER_ADMIN_EMAILS="muaz.gezali22@gmail.com"

# ------------------------------------------
# Application Domain / URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Data Security & Token Encryption (CRITICAL)
# ------------------------------------------
# 32-byte key for AES-256-GCM OAuth token encryption at rest.
# Can be a 64-character hex string, 44-character base64 string, or secure passphrase.
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ------------------------------------------
# Developer Mock Mode for OAuth & External API Testing
# ------------------------------------------
# Set to 'true' to simulate successful OAuth authorization flows without live app approvals
MOCK_OAUTH=true
# Set to 'true' to use mock metric responses for Google Ads, Meta Ads, and GA4 without external API calls
MOCK_EXTERNAL_APIS=true

# ------------------------------------------
# Third-Party OAuth Provider Credentials (PRODUCTION)
# ------------------------------------------
# Google Ads & Google Analytics 4
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Meta Ads (Facebook & Instagram)
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret

# ------------------------------------------
# Resend Email Delivery Configuration (SERVER-ONLY)
# ------------------------------------------
# Resend API key for dispatching white-labeled report emails with PDF attachments.
# If omitted or unset, Reportly runs in Developer Mock Mode (logging email payloads).
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------
# Automated Cron Job Security (SERVER-ONLY)
# ------------------------------------------
# Secret key required in Authorization header (Bearer <CRON_SECRET>) for /api/cron/monthly-reports
CRON_SECRET=your_cron_secret_key_here

# ------------------------------------------
# Stripe Billing & Subscription Configuration
# ------------------------------------------
# Stripe secret API key (server-only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe publishable key (safe for browser exposure)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Stripe webhook signing secret (server-only)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Pro tier Price ID (from Stripe Dashboard -> Products -> Pro Plan Price)
STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id






